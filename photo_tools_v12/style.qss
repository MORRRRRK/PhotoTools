/* PhotoTools V12.0 专业摄影工作站暗色主题 */
QMainWindow, QWidget {
    background-color: #121214;
    color: #e8e8ed;
    font-family: "Microsoft YaHei", "Inter", "SF Pro Display";
    font-size: 13px;
}

QMenuBar {
    background: #1a1a1f;
    color: #9a9aa5;
}
QMenuBar::item:selected {
    background: #222228;
    color: #e8e8ed;
}
QMenu {
    background: #1a1a1f;
    color: #e8e8ed;
    border: 1px solid #2e2e36;
}
QMenu::item:selected {
    background: #6366f1;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #2e2e36;
}

QToolBar {
    background: #1a1a1f;
    border-bottom: 1px solid #2e2e36;
    padding: 6px;
    spacing: 4px;
}
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
    color: #9a9aa5;
}
QToolButton:hover {
    background: #222228;
    color: #e8e8ed;
}
QToolButton:checked {
    background: #31313b;
    color: #e8e8ed;
}

QListWidget#navList {
    background: #121214;
    border: none;
    outline: 0;
    padding: 0;
}
QListWidget#navList::item {
    height: 40px;
    color: #9a9aa5;
    padding-left: 16px;
    border: none;
}
QListWidget#navList::item:hover {
    background: #222228;
    color: #e8e8ed;
}
QListWidget#navList::item:selected {
    background: #2a2a32;
    color: #e8e8ed;
    border-left: 3px solid #6366f1;
}

QPushButton {
    background: #222228;
    color: #e8e8ed;
    border: 1px solid #2e2e36;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover {
    background: #2a2a32;
}
QPushButton:pressed {
    background: #31313b;
}
QPushButton:disabled {
    color: #5a5a66;
    border-color: #2e2e36;
}
QPushButton[accent="true"] {
    background: #6366f1;
    color: #ffffff;
    border: none;
}
QPushButton[accent="true"]:hover {
    background: #818cf8;
}
QPushButton[accent="true"]:pressed {
    background: #4f46e5;
}
QPushButton[danger="true"] {
    background: #ef4444;
    color: #ffffff;
    border: none;
}
QPushButton[danger="true"]:hover {
    background: #f87171;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background: #222228;
    border: 1px solid #2e2e36;
    border-radius: 6px;
    padding: 6px 8px;
    color: #e8e8ed;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border-color: #6366f1;
}
QComboBox QAbstractItemView {
    background: #222228;
    border: 1px solid #2e2e36;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: 0;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e8e8ed;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #222228;
    border: 1px solid #2e2e36;
    border-radius: 4px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #6366f1;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #6366f1;
    border-color: #6366f1;
}

QProgressBar {
    background: #222228;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: #6366f1;
    border-radius: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a3a44;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4a4a55;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0;
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3a3a44;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4a4a55;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QTableWidget, QTableView {
    background: #1a1a1f;
    alternate-background-color: #1a1a1f;
    color: #e8e8ed;
    gridline-color: #2e2e36;
    border: none;
    selection-background-color: #2a2a32;
    selection-color: #e8e8ed;
}
QHeaderView::section {
    background: #222228;
    color: #9a9aa5;
    border: none;
    border-bottom: 1px solid #2e2e36;
    padding: 10px 12px;
}

QGroupBox {
    border: 1px solid #2e2e36;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    color: #9a9aa5;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QStatusBar {
    background: #1a1a1f;
    color: #9a9aa5;
    border-top: 1px solid #2e2e36;
}
QStatusBar::item {
    border: none;
}

QToolTip {
    background: #222228;
    color: #e8e8ed;
    border: 1px solid #6366f1;
    border-radius: 4px;
    padding: 4px 8px;
}

QFrame#overviewCard {
    background: #1a1a1f;
    border: none;
    border-radius: 8px;
}
QFrame#infoPanel {
    background: #1a1a1f;
    border: none;
    border-left: 1px solid #2e2e36;
}
QLabel#panelTitle {
    color: #e8e8ed;
    font-size: 13px;
    font-weight: 600;
}
QLabel#mutedLabel {
    color: #9a9aa5;
    font-size: 11px;
}
QLabel#bigScore {
    color: #e8e8ed;
    font-size: 36px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas";
}
QLabel#tagOk {
    background: rgba(16,185,129,0.16);
    color: #10b981;
    border-radius: 4px;
    padding: 2px 8px;
}
QLabel#tagWarn {
    background: rgba(245,158,11,0.16);
    color: #f59e0b;
    border-radius: 4px;
    padding: 2px 8px;
}
QLabel#tagDanger {
    background: rgba(239,68,68,0.16);
    color: #ef4444;
    border-radius: 4px;
    padding: 2px 8px;
}
