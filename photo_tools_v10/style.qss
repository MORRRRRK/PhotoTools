/* PhotoTools V10 深色摄影蓝主题 */
QMainWindow, QWidget {
    background-color: #252526;
    color: #CCCCCC;
    font-family: "Segoe UI", "Microsoft YaHei";
    font-size: 13px;
}

QMenuBar {
    background-color: #252526;
    color: #CCCCCC;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}
QMenuBar::item:selected {
    background: #3A3A3A;
    color: #FFFFFF;
}
QMenu {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #3A3A3A;
}
QMenu::item:selected {
    background: #4A90D9;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: #3A3A3A;
}

QToolBar {
    background: #252526;
    border-bottom: 1px solid #1A1A1A;
    spacing: 4px;
    padding: 4px;
}
QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}
QToolButton:hover {
    background: #3A3A3A;
}
QToolButton:checked, QToolButton:pressed {
    background: #4A90D9;
}

QListWidget#navList {
    background-color: #1E1E1E;
    border: none;
    outline: 0;
    padding: 4px;
}
QListWidget#navList::item {
    height: 48px;
    color: #CCCCCC;
    padding-left: 12px;
    border: none;
}
QListWidget#navList::item:hover {
    background: #2D2D30;
}
QListWidget#navList::item:selected {
    background: #4A90D9;
    color: #FFFFFF;
}

QListView#thumbGrid {
    background-color: #1A1A1A;
    border: none;
}
QListView#thumbGrid::item {
    margin: 4px;
    padding: 4px;
    border-radius: 4px;
}
QListView#thumbGrid::item:hover {
    background: #2D2D30;
    border: 1px solid #4A90D9;
}
QListView#thumbGrid::item:selected {
    background: #2D2D30;
    border: 2px solid #4A90D9;
}

QPushButton {
    background: transparent;
    color: #CCCCCC;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover {
    border-color: #4A90D9;
    color: #FFFFFF;
}
QPushButton:pressed {
    background: #3A80C9;
    color: #FFFFFF;
}
QPushButton:disabled {
    color: #666666;
    border-color: #444444;
}
QPushButton[accent="true"] {
    background: #4A90D9;
    color: #FFFFFF;
    border: none;
}
QPushButton[accent="true"]:hover {
    background: #5BA0E9;
}
QPushButton[accent="true"]:pressed {
    background: #3A80C9;
}
QPushButton[danger="true"] {
    background: #C0392B;
    color: #FFFFFF;
    border: none;
}
QPushButton[danger="true"]:hover {
    background: #D24C3D;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: #2D2D30;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px 8px;
    color: #FFFFFF;
    selection-background-color: #4A90D9;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #4A90D9;
}
QLineEdit:disabled {
    color: #666666;
}

QComboBox {
    background: #2D2D30;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px 8px;
    color: #FFFFFF;
    min-height: 20px;
}
QComboBox:focus {
    border-color: #4A90D9;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #2D2D30;
    border: 1px solid #444444;
    selection-background-color: #4A90D9;
    selection-color: #FFFFFF;
    outline: 0;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #CCCCCC;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #2D2D30;
    border: 1px solid #555555;
    border-radius: 3px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #4A90D9;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #4A90D9;
    border-color: #4A90D9;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #3A3A3A;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #4A90D9;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #FFFFFF;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #4A90D9;
}

QProgressBar {
    background: #3A3A3A;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: #4A90D9;
    border-radius: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #777777;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0;
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #777777;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    background: #252526;
}
QTabBar::tab {
    background: #1E1E1E;
    color: #888888;
    padding: 8px 16px;
    border: none;
}
QTabBar::tab:selected {
    background: #252526;
    color: #FFFFFF;
    border-bottom: 2px solid #4A90D9;
}
QTabBar::tab:hover {
    color: #FFFFFF;
}

QGroupBox {
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    color: #888888;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QStatusBar {
    background: #1E1E1E;
    color: #888888;
    border-top: 1px solid #1A1A1A;
}
QStatusBar::item {
    border: none;
}

QToolTip {
    background: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #4A90D9;
    border-radius: 4px;
    padding: 4px 8px;
}

QTableWidget, QTableView {
    background: #1A1A1A;
    alternate-background-color: #252526;
    color: #CCCCCC;
    gridline-color: #333333;
    border: 1px solid #333333;
    selection-background-color: #4A90D9;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background: #2D2D30;
    color: #CCCCCC;
    border: none;
    border-bottom: 1px solid #444444;
    padding: 6px;
}
